# Example configuration for a fictional council build.
# Copy this file to ".env", fill in YOUR OWN values, and never commit the copy.
# Every value below is a FAKE placeholder.

# --- Main assistant ---
ASSISTANT_NAME=Nova

# --- Cloud seats (one block per provider you connect) ---
SEAT_A_PROVIDER=cloud-provider-a
SEAT_A_MODEL=model-a-exact-version
SEAT_A_API_KEY=replace-with-your-own-key

SEAT_B_PROVIDER=cloud-provider-b
SEAT_B_MODEL=model-b-exact-version
SEAT_B_API_KEY=replace-with-your-own-key

SEAT_C_PROVIDER=cloud-provider-c
SEAT_C_MODEL=model-c-exact-version
SEAT_C_API_KEY=replace-with-your-own-key

# --- Local seat (runs on your own hardware, e.g. the fictional "homebase") ---
LOCAL_SEAT_ENDPOINT=http://homebase.local:0000
LOCAL_SEAT_MODEL=local-model-name-and-size

# --- Spending safety ---
# Keep prepaid balances small and auto-reload OFF on every provider account.
MONTHLY_COUNCIL_BUDGET_USD=10
